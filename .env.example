# Copy to .env for local development. NEVER commit the real .env.
DEBUG=True

# Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-in-production

# Optional dedicated JWT signing key. Falls back to SECRET_KEY.
# JWT_SIGNING_KEY=

ALLOWED_HOSTS=localhost,127.0.0.1

# Local SQLite by default; Postgres example:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/drf_db
# DATABASE_URL=sqlite:///db.sqlite3

# Where verification / reset links point.
FRONTEND_URL=http://localhost:3000

# Refresh cookie. Secure defaults to (not DEBUG); SameSite=Lax works for
# same-site frontends. Use SameSite=None + Secure + a CSRF defense for a
# truly cross-site frontend.
# AUTH_COOKIE_SECURE=True
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_PATH=/api/v1/auth/

# Email (console backend prints links in local development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com

# Production example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Set to True behind a TLS-terminating reverse proxy.
# TRUST_PROXY_HEADERS=True
